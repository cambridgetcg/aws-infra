{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegionalInventoryEnumeration",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeVpcs",
        "rds:DescribeDBInstances",
        "ecs:ListClusters",
        "dynamodb:ListTables",
        "sqs:ListQueues",
        "cloudformation:ListStacks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LambdaListingIncludesConfiguration",
      "Effect": "Allow",
      "Action": "lambda:ListFunctions",
      "Resource": "*"
    },
    {
      "Sid": "GlobalBucketNames",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    }
  ]
}
